# =============================================================================
# Petanque Master — Variables d'environnement (template)
# =============================================================================
# Copie ce fichier en .env (gitignored) et remplis les valeurs.
# Aucune cle ici n'est obligatoire pour faire tourner le jeu en local.
# =============================================================================

# --- MCP API keys (generation assets, pas le runtime du jeu) ------------------
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxx
# PIXELLAB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Analytics Umami (optionnel) ---------------------------------------------
# Cookieless, RGPD/CNIL exempt — pas besoin de banniere consentement.
# Si non defini, aucun script analytics charge (no-op cote client).
# Voir docs/lancement/UMAMI_SETUP.md pour le self-host.
# VITE_UMAMI_SCRIPT_URL=https://umami.tondomaine.com/script.js
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# --- Sentry error tracking (optionnel, branchement futur) --------------------
# VITE_SENTRY_DSN=https://xxx@xxx.sentry.io/123456
